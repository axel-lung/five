{
  "name": "five",
  "version": "1.0.0",
  "description": "Five/Futsal — monorepo (backend, app web + iOS + Android)",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "mobile": "npm run start --workspace five-mobile",
    "web": "npm run web --workspace five-mobile",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "expo": "~52.0.49",
    "react": "18.3.1",
    "react-native": "0.76.9"
  }
}
