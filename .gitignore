  # Dependencies
  /node_modules
  /backend/node_modules
  /frontend/node_modules

  # Build outputs
  /dist
  /build
  /backend/dist
  /frontend/dist

  # Environment variables (SECRET - do not commit real values!)
  .env
  .env.local
  .env.*.local

  # Docker
  # Named volumes are managed by Docker Compose, not git
  # But if you ever docker-compose down -v, you'll lose data
  # The important thing is to not commit volume contents

  # Logs
  *.log
  npm-debug.log*
  yarn-debug.log*
  yarn-error.log*
  pids
  *.pid
  *.seed

  # IDE/Editor
  .vscode/
  .idea/
  *.swp
  *.swo
  *~

  # OS
  .DS_Store
  Thumbs.db

  # Misc
  .coverage
  .cache
  .nyc_output

  # Backup/backup files
  *.bak
  *.tmp

  # TypeScript
  *.tsbuildinfo

