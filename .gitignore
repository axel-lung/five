# Dependencies
node_modules*
backend/node_modules/*
frontend/node_modules/*

# Bases Postgres ephemeres (tests et npm run dev:local)
backend/.pg-test/
backend/.pg-dev/

# Build outputs
dist/*
build/*
backend/dist/*
frontend/dist/*

# Environment variables (SECRET - do not commit real values!)
.env
.env.local
.env.*.local

# Docker
# Named volumes are managed by Docker Compose, not git
# But if you ever docker-compose down -v, you'll lose data
# The important thing is to not commit volume contents

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids
*.pid
*.seed

# IDE/Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Misc
.coverage
.cache
.nyc_output

# Backup/backup files
*.bak
*.tmp

# TypeScript
*.tsbuildinfo
# Playwright
frontend/test-results/
frontend/playwright-report/

# Export web de l'app mobile et sorties Playwright
apps/mobile/dist/
apps/mobile/test-results/
apps/mobile/playwright-report/

# Cle de compte de service Firebase (FCM) : elle autorise l'envoi de push vers
# l'application, et ne doit JAMAIS etre commitee. Elle ne vit qu'en local, le
# temps d'etre televersee chez Expo (`eas credentials`).
#
# Attention a ne pas ignorer google-services.json avec : celui-la DOIT etre
# versionne. Il ne contient pas de secret, et `actions/checkout` ne recuperant
# que les fichiers suivis, `expo prebuild` echouerait sans lui.
*-firebase-adminsdk-*.json
firebase-service-account*.json
