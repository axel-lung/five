version: '3.8'

services:
  # Traefik Reverse Proxy
  traefik:
    image: traefik:v2.10
    container_name: five_traefik
    restart: unless-stopped
    ports:
      - "80:80"      # HTTP
      - "443:443"    # HTTPS
      - "8080:8080"  # Traefik Dashboard (optional)
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ./traefik.yml:/traefik.yml:ro
      - ./acme.json:/acme.json
    command:
      - --api.insecure=true
      - --providers.docker=true
      - --providers.docker.exposedbydefault=false
      - --entrypoints.web.address=:80
      - --entrypoints.websecure.address=:443
      - --certificatesresolvers.myresolver.acme.tlschallenge=true
      - --certificatesresolvers.myresolver.acme.email=admin@alng.fr
      - --certificatesresolvers.myresolver.acme.storage=/acme.json
    networks:
      - five-network

  # PostgreSQL Database
  db:
    image: postgres:15-alpine
    container_name: five_db
    restart: unless-stopped
    environment:
      POSTGRES_DB: five
      POSTGRES_USER: five_user
      POSTGRES_PASSWORD: five_password_${DB_PASSWORD:-changeme}
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./init-scripts/db.init.sql:/docker-entrypoint-initdb.d/init.sql:ro
    networks:
      - five-network
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U five_user -d five"]
      interval: 10s
      timeout: 5s
      retries: 5

  # MinIO for file storage (S3 compatible)
  minio:
    image: minio/minio:latest
    container_name: five_minio
    restart: unless-stopped
    command: server /data --console-address ":9001"
    environment:
      MINIO_ROOT_USER: minioadmin
      MINIO_ROOT_PASSWORD: minioadmin_${MINIO_PASSWORD:-changeme}
    volumes:
      - minio_data:/data
    networks:
      - five-network
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:9000/minio/health/ready"]
      interval: 10s
      timeout: 5s
      retries: 5

  # Backend API (Node.js/TypeScript)
  backend:
    build:
      context: ./backend
      dockerfile: Dockerfile
    container_name: five_backend
    restart: unless-stopped
    env_file:
      - .env.example
    environment:
      - DATABASE_URL=postgresql://five_user:${DB_PASSWORD:-changeme}@db:5432/five
      - MINIO_ENDPOINT=minio:9000
      - MINIO_ACCESS_KEY=minioadmin
      - MINIO_SECRET_KEY=${MINIO_PASSWORD:-changeme}
      - MINIO_USE_SSL=false
      - JWT_SECRET=${JWT_SECRET:-your_jwt_secret_change_this_in_production}
      - NODE_ENV=development
    volumes:
      - ./backend/src:/usr/src/app/src
      - ./backend/package.json:/usr/src/app/package.json
      - ./backend/tsconfig.json:/usr/src/app/tsconfig.json
    networks:
      - five-network
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.five-api.rule=Host(`five.alng.fr`) && PathPrefix(`/api`)"
      - "traefik.http.routers.five-api.entrypoints=web"
      - "traefik.http.routers.five-api.middlewares=api-prefix"
      - "traefik.http.middlewares.api-prefix.stripprefix.prefixes=/api"
      - "traefik.http.routers.five-api.tls=true"
      - "traefik.http.routers.five-api.tls.certresolver=myresolver"
    depends_on:
      db:
        condition: service_healthy
      minio:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spare", "http://localhost:3000/health || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5

  # Frontend React App
  frontend:
    build:
      context: ./frontend
      dockerfile: Dockerfile
    container_name: five_frontend
    restart: unless-stopped
    env_file:
      - .env.example
    environment:
      - REACT_APP_API_URL=https://five.alng.fr/api
      - NODE_ENV=production
    volumes:
      - ./frontend/src:/usr/src/app/src
      - ./frontend/package.json:/usr/src/app/package.json
    networks:
      - five-network
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.five-frontend.rule=Host(`five.alng.fr`) && PathPrefix(`/`) || PathPrefixSlice(`/`, 1)"
      - "traefik.http.routers.five-frontend.entrypoints=websecure"
      - "traefik.http.routers.five-frontend.tls=true"
      - "traefik.http.routers.five-frontend.tls.certresolver=myresolver"
    depends_on:
      - backend

networks:
  five-network:
    driver: bridge

volumes:
  postgres_data:
  minio_data: