# Variables d'environnement pour Five/Futsal
#
# IMPORTANT : copier ce fichier en `.env` a la racine du projet.
#   cp .env.example .env
# Docker Compose lit UNIQUEMENT un fichier nomme `.env` pour resoudre les
# ${VARIABLES} de docker-compose.yml. Un `env_file: .env.example` ne sert PAS
# a ca (il ne fait qu'injecter des variables dans le conteneur).

# Suffixe du mot de passe Postgres.
# Le mot de passe reel est "five_password_<DB_PASSWORD>" (voir docker-compose.yml).
DB_PASSWORD=change_me_postgres

# Suffixe du mot de passe MinIO.
# Le mot de passe reel est "minioadmin_<MINIO_PASSWORD>".
MINIO_PASSWORD=change_me_minio

# Secret JWT - obligatoire, le stack refuse de demarrer sans.
# Generer avec : openssl rand -hex 32
JWT_SECRET=

# Bucket MinIO des avatars. Cree au premier upload s'il n'existe pas.
# MinIO n'etant pas expose publiquement, les images sont resservies par
# l'API via GET /api/media/:key ; aucune route Traefik supplementaire.
MEDIA_BUCKET=five-media

# URL de l'API consommee par le frontend.
# Note : cette valeur est passee en --build-arg (VITE_APP_API_URL) dans
# docker-compose.yml ; Vite fige les variables au build, pas au runtime.
VITE_APP_API_URL=https://five.alng.fr/api
