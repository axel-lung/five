# Environment variables for Five/Futsal application

# Database
DATABASE_URL=postgresql://five_user:five_password@localhost:5432/five
DB_PASSWORD=your_postgres_password_here

# MinIO
MINIO_PASSWORD=your_minio_password_here

# JWT
JWT_SECRET=your_jwt_secret_change_this_in_production

# Node Environment
NODE_ENV=development

# Frontend (for Vite)
# When using Traefik, the frontend is served at https://five.alng.fr
# and the API is at https://five.alng.fr/api
REACT_APP_API_URL=https://five.alng.fr/api