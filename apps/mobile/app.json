{
  "expo": {
    "name": "Five",
    "slug": "five-futsal",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "five",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.alng.five"
    },
    "android": {
      "package": "fr.alng.five"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
