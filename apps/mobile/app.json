{
  "expo": {
    "name": "HighFive",
    "slug": "five-futsal",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "five",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "HighFive accède à vos photos pour les partager dans la discussion de votre groupe."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.alng.five"
    },
    "android": {
      "package": "fr.alng.five"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
